#!/usr/bin/env bash
set -euo pipefail
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
OS="$(uname -s)"

# CI / non-interactive mode (DOTFILES_CI=1): skip the checklist, disable the groups
# that can't run headless (watcher daemon, GitHub SSH, GUI apps), auto-fill machine name.
CI_MODE="${DOTFILES_CI:-0}"

# ask / pkg_install / ensure_tool / parse_toggles — kept in a sourceable lib so
# the cross-OS dispatch and the checklist parser are unit-tested
# (tests/dotfiles-install-lib.bats). The lib also pulls in bin/dotfiles-ui
# (phase/ok/info/run_quiet + the UI_* style vars) for styled output.
# shellcheck source=bin/dotfiles-install-lib
. "$DOTFILES/bin/dotfiles-install-lib"

# Number of phases below, for the "[n/UI_TOTAL]" step counter. The checklist is
# not counted — it's the up-front selection, not an install step.
UI_TOTAL=12

# Registry-driven install glue. The dependency facts (package per OS, probe, install
# hint) live once in deps.tsv / apps.tsv and are read via bin/dotfiles-deps (the
# read-only accessor). These turn its rows into the existing install adapters, so a
# new dependency is a data row — not another call site here. dotfiles-deps is invoked
# by repo path (it predates `make bin-link`, which runs later).
install_tools() {  # install_tools <group> — every deps.tsv tool in <group> via ensure_tool
  local probe darwin linux required desc
  while IFS=$'\t' read -r probe darwin linux required desc; do
    if [[ "$required" == "yes" ]]; then
      ensure_tool "$probe" "$darwin" "$linux" --required "$desc"
    else
      ensure_tool "$probe" "$darwin" "$linux" "$desc"
    fi
  done < <("$DOTFILES/bin/dotfiles-deps" list "$1")
}

install_apps() {  # install_apps core|extra — eza is core (always on), the GUI apps are DO_APPS extras
  local which="$1" key label default
  while IFS=$'\t' read -r key label default; do
    case "$which" in
      core)  [[ "$key" == "eza" ]] || continue ;;
      extra) [[ "$key" == "eza" ]] && continue ;;
    esac
    ensure_app_key "$key" "$label" "$default"
  done < <("$DOTFILES/bin/dotfiles-deps" apps)
}

# --- pre-checklist gates ---------------------------------------------------
# A couple of things run before the checklist (and before ASSUME_YES) so they
# stay explicit yes/no rather than being auto-confirmed:
#
# 1. Homebrew — a hard, macOS-only prerequisite (everything else installs through
#    it), confirmed first with its own explanation. The one yes/no outside the
#    checklist; up front so a fresh Mac isn't asked to install it only *after*
#    filling out the checklist. (curl, used below, ships with macOS.)
if [[ "$OS" == "Darwin" ]] && ! command -v brew >/dev/null 2>&1; then
  cat <<'EOF'
Homebrew is required to install stow/fswatch on macOS but isn't installed.
The official installer (https://brew.sh) will prompt for your sudo password,
install Xcode Command Line Tools if needed, and place brew under
/opt/homebrew (Apple Silicon) or /usr/local (Intel).
EOF
  if ask "Install Homebrew now?"; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  else
    warn "skipped; cannot install macOS dependencies without Homebrew"
    exit 1
  fi
fi

# 2. Repo seeding — rare authoring path (only when this repo has no tracked
#    .zshrc); seeding copies live $HOME configs into the repo, so it shouldn't be
#    auto-confirmed.
if [[ ! -f "$DOTFILES/zsh/.zshrc" ]]; then
  if ask "No tracked .zshrc in repo. Seed from live configs in \$HOME?"; then
    "$DOTFILES/bin/dotfiles-seed"
  fi
fi

# --- the one up-front confirmation: choose what to install ---------------
# Every group defaults ON; toggle any OFF by number, then Enter accepts the shown
# selection. After this, nothing else asks yes/no (ASSUME_YES is set in the
# dependency phase) — only the value prompts (machine name, git identity) and
# unavoidable sudo prompts remain. The order here is the canonical 1..N the toggle
# parser and the DO_* mapping below rely on.
group_names=(
  "tmux plugins (TPM)"
  "fish plugins (fisher)"
  "default shell → fish"
  "desktop apps (kitty, Obsidian, 1Password)"
  "GitHub SSH auth"
  "watcher (auto-sync to git)"
  "test tooling (bats + parallel)"
)
group_state=(1 1 1 1 1 1 1)   # all ON by default

render_checklist() {
  local i mark
  printf '\n%s▶ Choose what to install%s %s(all on — type numbers to toggle off, Enter to accept)%s\n' \
    "$UI_BOLD" "$UI_RST" "$UI_DIM" "$UI_RST"
  for i in "${!group_names[@]}"; do
    [[ "${group_state[$i]}" == 1 ]] && mark="x" || mark=" "
    printf '  [%s] %d %s\n' "$mark" "$((i + 1))" "${group_names[$i]}"
  done
}

if [[ "$CI_MODE" == 1 ]]; then
  # indices: 3=desktop apps, 4=GitHub SSH, 5=watcher — off in CI (can't run headless)
  group_state[3]=0; group_state[4]=0; group_state[5]=0
  info "CI mode: desktop apps, GitHub SSH, watcher disabled"
else
  toggle_line=""
  while :; do
    render_checklist
    # read fails on EOF (piped / no tty) — `|| true` keeps set -e happy; an empty
    # line then accepts the shown (all-on) defaults, so a non-interactive run is
    # fully unattended.
    read -rp "  toggle (e.g. 4 7), or Enter to accept: " toggle_line || true
    [[ -z "${toggle_line//[[:space:]]/}" ]] && break
    if ! toggles="$(parse_toggles "$toggle_line" "${#group_names[@]}")"; then
      warn "invalid — enter numbers 1-${#group_names[@]} (got: $toggle_line)"
      continue
    fi
    for t in $toggles; do
      i=$((t - 1))
      group_state[i]=$((1 - group_state[i]))
    done
  done
fi

DO_TMUX=${group_state[0]}
DO_FISH=${group_state[1]}
DO_SHELL=${group_state[2]}
DO_APPS=${group_state[3]}
DO_SSH=${group_state[4]}
DO_WATCHER=${group_state[5]}
DO_TEST=${group_state[6]}

# Machine name (used in the watcher's commit messages + as the SSH key title,
# stored in the gitignored machine.local). Asked up front with the other value
# input; idempotent — skipped once the file exists.
phase "Machine name"
if [[ -s "$DOTFILES/machine.local" ]]; then
  info "using $(cat "$DOTFILES/machine.local") (machine.local already set)"
else
  if [[ "$OS" == "Darwin" ]]; then
    default_name="$(scutil --get ComputerName 2>/dev/null || hostname -s)"
  else
    default_name="$(hostname -s)"
  fi
  if [[ "$CI_MODE" == 1 ]]; then
    mname="ci-$(printf '%s' "$OS" | tr '[:upper:]' '[:lower:]')"
  else
    # `|| true` so an EOF (piped/unattended) run falls through to the default
    # rather than aborting under set -e — matches the git-identity reads below.
    read -rp "Machine name (used in commit messages) [${default_name}]: " mname || true
    mname="${mname:-$default_name}"
  fi
  echo "$mname" > "$DOTFILES/machine.local"
  ok "saved machine name: $mname"
fi

phase "Checking dependencies"
# Consent is gathered — from here every prompt (including the ones inside
# ensure_tool / ensure_app) auto-confirms. Homebrew (macOS) was already
# bootstrapped in the pre-checklist gate above.
ASSUME_YES=1

# Core tools come from the registry's `core` group (stow/git required; fish/tmux/
# curl/bat soft) — see deps.tsv for the package-per-OS facts and per-tool rationale.
install_tools core
# eza is a core app, not a core tool: it's ensure_app (not ensure_tool) because its
# Linux install needs a community-repo fallback on releases where it isn't yet in
# apt. It backs the always-on fish-exa aliases, so it installs in every run.
install_apps core

# Watcher deps — ensured only when the watcher group is on. The fswatch/inotifywait
# file-event backend's "install only if neither alternative is present" falls out of
# the combined deps.tsv probe row (any alternative on PATH ⇒ satisfied); coreutils
# (gtimeout) and flock are macOS-only reliability extras ('-' linux-pkg makes them
# no-ops on Linux, which ships them with coreutils / util-linux).
if [[ "$DO_WATCHER" == 1 ]]; then
  install_tools watcher
fi

# gh (GitHub CLI) — only needed by the GitHub SSH group to auto-register the key
# (it falls back to manual paste when absent). On Ubuntu it's in the Universe
# component (enabled by default on desktop).
if [[ "$DO_SSH" == 1 ]]; then
  install_tools ssh
fi

# Global git user.name / user.email back every commit, including the watcher's
# auto-sync; on a fresh box they're unset (which is why generate_ssh_key guards
# its email lookup). Prompted as value input like the machine name and
# idempotent — each is skipped once already set. Written to the gitignored global
# ~/.gitconfig, never to this repo, so no employer/identity detail lands in a
# tracked file. Sits after the dependency phase (so `git` is on PATH) and before
# the GitHub SSH phase, so a freshly-set email also becomes the SSH key comment.
# `read` is `|| true`-guarded so an EOF (piped/unattended) run falls through to
# the default and just leaves the value unset rather than aborting under set -e.
phase "Git identity"
cur_name="$(git config --global user.name 2>/dev/null || true)"
if [[ -n "$cur_name" ]]; then
  info "using git user.name: $cur_name (already set)"
else
  if [[ "$OS" == "Darwin" ]]; then
    default_name="$(id -F 2>/dev/null || true)"
  else
    default_name="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f5 | cut -d, -f1)"
  fi
  read -rp "Git user.name${default_name:+ [$default_name]}: " gname || true
  gname="${gname:-$default_name}"
  if [[ -n "$gname" ]]; then
    git config --global user.name "$gname"
    ok "set git user.name: $gname"
  else
    skip "git user.name left unset"
  fi
fi
cur_email="$(git config --global user.email 2>/dev/null || true)"
if [[ -n "$cur_email" ]]; then
  info "using git user.email: $cur_email (already set)"
else
  # No default: there's no reliable system source for an email, and hard-coding
  # one would bake a personal/employer address into this public repo.
  read -rp "Git user.email: " gemail || true
  if [[ -n "$gemail" ]]; then
    git config --global user.email "$gemail"
    ok "set git user.email: $gemail"
  else
    skip "git user.email left unset"
  fi
fi

phase "Symlinking packages with stow"
run_quiet "stow packages" -- make -s -C "$DOTFILES" stow

phase "Linking user-facing bin tools"
run_quiet "link bin tools" -- make -s -C "$DOTFILES" bin-link

phase "Test tooling (bats + parallel)"
if [[ "$DO_TEST" != 1 ]]; then
  skip "test tooling skipped"
else
  install_tools test
  # Suppress GNU parallel's first-run citation banner so it doesn't pollute test
  # output. Idempotent and safe whether or not we just installed parallel.
  mkdir -p "$HOME/.parallel" && touch "$HOME/.parallel/will-cite"
fi

phase "tmux plugins (TPM)"
if [[ "$DO_TMUX" == 1 ]]; then
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    run_quiet "clone TPM" -- git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  fi
  # install_plugins reads TMUX_PLUGIN_MANAGER_PATH from the tmux *server* global
  # env (not the shell), where it's normally set by tpm's run line in .tmux.conf.
  # Seed it directly as insurance: on a fresh box this is a no-op (the empty
  # server exits and install_plugins re-sources the config), but if a stale
  # server is already running without the var, this sets it so the install
  # doesn't fail with "unknown variable: TMUX_PLUGIN_MANAGER_PATH".
  tmux start-server \; set-environment -g TMUX_PLUGIN_MANAGER_PATH "$HOME/.tmux/plugins" 2>/dev/null || true
  run_quiet "install tmux plugins" -- "$HOME/.tmux/plugins/tpm/bin/install_plugins" || true
else
  skip "tmux plugins skipped"
fi

phase "fish plugins (fisher)"
if [[ "$DO_FISH" == 1 ]]; then
  # Plugins are vendored: every plugin's files are committed under
  # fish/.config/fish/{functions,completions,conf.d} and are already active on a
  # fresh box through the stow symlinks — fish autoloads them with no network.
  #
  # So this phase deliberately fetches nothing. The old `fisher install
  # jorgebucaran/fisher` + `fisher update` re-downloaded every plugin from the
  # unauthenticated GitHub API (60 req/hr/IP) and then rewrote fish_plugins from
  # whatever survived the fetch. Because ~/.config/fish/fish_plugins is a stow
  # symlink back into this repo, a single failed fetch (rate limit / transient
  # network, common on a fresh box) silently truncated the tracked manifest down
  # to just the plugins that happened to download — that's the "fish_plugins
  # wiped to one line + stray functions/fisher.fish" breakage.
  #
  # All a fresh box needs is to register the tracked plugin list into the
  # _fisher_plugins universal var, so a later *explicit* `fisher update`/`remove`
  # knows what's installed. fish_variables is gitignored, so this stays runtime
  # state. Refresh plugins deliberately, from a box with API access, by running
  # `fisher update` by hand (it will rewrite these committed files).
  run_quiet "register vendored fish plugins" -- fish -c '
    test -e $__fish_config_dir/fish_plugins
    and set -U _fisher_plugins (string match --regex -- "^[^\s]+\$" <$__fish_config_dir/fish_plugins)
  ' || true

  # Seed the curated plugin config (tide prompt, fish-exa, abbr-tips) on a box
  # that's never been configured. These settings normally come from each
  # plugin's one-time `_install` event, which we don't fire (plugins are
  # vendored, not `fisher install`ed); tide's live in gitignored fish_variables,
  # so a fresh box has none and renders a blank prompt. Guarded on
  # tide_left_prompt_items[1] (the persistent config var the seed sets) so a box
  # you've since customized is left untouched. The [1] index matters: the first
  # interactive prompt render can create a set-but-empty _tide_left_items cache
  # var, and fish's `set -q` is true for a set-but-empty var — guarding on a bare
  # name would wrongly think tide was configured and skip the seed.
  # Sourcing the seed sets the universal vars (the persistent fix — tide's
  # fish_prompt reads them live, so the next interactive shell renders the
  # prompt). `tide reload` only refreshes a live *interactive* shell; here in a
  # throwaway non-interactive `fish -c` it's a harmless no-op (fish_prompt.fish
  # early-exits on `status is-interactive`), kept so the same block also works if
  # ever sourced interactively.
  run_quiet "seed plugin config (tide prompt etc.)" -- fish -c '
    set -q tide_left_prompt_items[1]; and exit 0
    test -e $__fish_config_dir/seed-universal.fish; or exit 0
    source $__fish_config_dir/seed-universal.fish
    tide reload 2>/dev/null
  ' || true

  # Re-apply the local tide prompt patch (clear-screen on COLUMNS changes). The
  # vendored fish_prompt.fish ships patched, so this is a no-op on a fresh box —
  # but a manual `fisher update` regenerates that file from stock tide and
  # silently drops the patch, re-introducing the soft-zoom prompt-stacking bug
  # (duplicate prompts when navigating panes while maximized). Restore it on
  # every install so a repaired box always has it.
  run_quiet "patch tide prompt (soft-zoom redraw)" -- "$DOTFILES/bin/dotfiles-tide-prompt-patch" || true
else
  skip "fish plugins skipped"
fi

phase "Default shell (fish)"
if [[ "$DO_SHELL" != 1 ]]; then
  skip "login shell unchanged"
else
  fish_path="$(command -v fish || true)"
  if [[ -z "$fish_path" ]]; then
    skip "fish not installed; leaving login shell unchanged"
  else
    # Read the actual login shell from the password database — $SHELL is the shell
    # that launched the installer, not necessarily the login shell.
    if [[ "$OS" == "Darwin" ]]; then
      current_shell="$(dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}')"
    else
      current_shell="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
    fi
    if [[ "$current_shell" == "$fish_path" ]]; then
      ok "fish is already your login shell"
    else
      # chsh only accepts a shell listed in /etc/shells. Both the grep append and
      # chsh may prompt for your password, so keep them in the foreground.
      grep -qxF "$fish_path" /etc/shells 2>/dev/null \
        || echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
      if chsh -s "$fish_path"; then
        SHELL_CHANGED=1
        ok "login shell set to fish (log out and back in to take effect)"
      else
        warn "chsh failed; set it by hand with: chsh -s $fish_path"
      fi
    fi
  fi
fi

phase "Optional desktop apps"
if [[ "$DO_APPS" == 1 ]]; then
  install_apps extra
else
  skip "desktop apps skipped"
fi

phase "GitHub SSH auth"
if [[ "$DO_SSH" == 1 ]]; then
  # machine.local is populated by the earlier "Machine name" phase, so its first
  # line is the SSH key title. Runs before the watcher so an HTTPS-cloned repo is
  # push-ready by the time the watcher is installed.
  # `|| true` per ensure_github_ssh's documented contract: it's best-effort and
  # runs here under live `set -e`, so an internal non-zero must not abort the
  # bootstrap before the watcher phase.
  ensure_github_ssh "$DOTFILES" "$(cat "$DOTFILES/machine.local" 2>/dev/null)" || true
else
  skip "GitHub SSH setup skipped"
fi

phase "Watcher (auto-sync to git)"
if [[ "$DO_WATCHER" == 1 ]]; then
  # Uses the Makefile's default DEBOUNCE_SECS (180) / PULL_INTERVAL_SECS (21600);
  # tune later via `make watcher-install DEBOUNCE_SECS=… PULL_INTERVAL_SECS=…`.
  make -s -C "$DOTFILES" watcher-install
else
  skip "watcher skipped"
fi

ok "done — run 'make help' to see commands"

# A freshly-changed login shell doesn't take effect in the current GUI session
# (it caches $SHELL until logout). The per-phase note scrolls away among the
# phases above, so repeat it prominently at the end — but only when chsh
# actually changed the shell this run.
if [[ "${SHELL_CHANGED:-0}" == 1 ]]; then
  warn "fish is now your login shell, but this session and any open terminals still use your previous shell."
  info "Log out and back in (or reboot) for kitty / new terminals to launch fish and auto-start tmux."
fi
