#!/usr/bin/env bash
set -euo pipefail
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
OS="$(uname -s)"

# ask / pkg_install / ensure_tool — kept in a sourceable lib so ensure_tool's
# cross-OS dispatch is unit-tested (tests/dotfiles-install-lib.bats).
# shellcheck source=bin/dotfiles-install-lib
. "$DOTFILES/bin/dotfiles-install-lib"

echo "==> Checking dependencies"
if [[ "$OS" == "Darwin" ]] && ! command -v brew >/dev/null 2>&1; then
  cat <<'EOF'
Homebrew is required to install stow/fswatch on macOS but isn't installed.
The official installer (https://brew.sh) will prompt for your sudo password,
install Xcode Command Line Tools if needed, and place brew under
/opt/homebrew (Apple Silicon) or /usr/local (Intel).
EOF
  if ask "Install Homebrew now?"; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [[ -x /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -x /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
  else
    echo "  skipped; cannot install macOS dependencies without Homebrew"
    exit 1
  fi
fi
ensure_tool stow stow stow --required
ensure_tool git  git  git  --required

# Shell + multiplexer whose configs this repo manages (fish/, tmux/). Not
# required to stow, but the fisher and TPM steps below assume they're present —
# and a stowed config for a tool you haven't installed is dead weight. The
# package name matches the command name on both brew and apt.
ensure_tool fish fish fish "fish not found (its config is managed here)"
ensure_tool tmux tmux tmux "tmux not found (its config is managed here)"

if ! command -v fswatch >/dev/null 2>&1; then
  if [[ "$OS" == "Darwin" ]]; then
    ask "fswatch not found. brew install fswatch?" && brew install fswatch || true
  elif ! command -v inotifywait >/dev/null 2>&1; then
    ask "inotifywait not found. sudo apt-get install inotify-tools?" && \
      sudo apt-get install -y inotify-tools || true
  fi
fi

# Watcher reliability extras. macOS only — Linux ships both with coreutils /
# util-linux, so the "-" linux-pkg makes these no-ops there. coreutils provides
# `gtimeout` for the watcher's network-op timeout backstop (without it,
# fetch/pull/push run unwrapped — SSH keepalives still apply, but a wedged op
# they can't see won't be killed). flock provides the single-instance lock
# (without it, two watcher processes can race). Both degrade gracefully in the
# watcher, so they're offered, not forced.
ensure_tool "gtimeout timeout" coreutils - "coreutils not found (provides gtimeout for the watcher's network-op timeout backstop)"
ensure_tool flock flock - "flock not found (provides the watcher single-instance lock)"

if [[ ! -f "$DOTFILES/zsh/.zshrc" ]]; then
  if ask "No tracked .zshrc in repo. Seed from live configs in \$HOME?"; then
    "$DOTFILES/bin/dotfiles-seed"
  fi
fi

echo "==> Symlinking packages with stow"
make -C "$DOTFILES" stow

echo "==> Linking user-facing bin tools"
make -C "$DOTFILES" bin-link

if ! command -v bats >/dev/null 2>&1 || ! command -v parallel >/dev/null 2>&1; then
  if ask "Install bats-core and GNU parallel (required for \`make test\`)?" N; then
    if [[ "$OS" == "Darwin" ]]; then
      brew install bats-core parallel
    else
      sudo apt-get install -y bats parallel
    fi
    # Suppress GNU parallel's first-run citation banner so it doesn't pollute test output.
    mkdir -p "$HOME/.parallel" && touch "$HOME/.parallel/will-cite"
  fi
fi

if ask "Install TPM and tmux plugins?"; then
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  fi
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" || true
fi

if ask "Install fisher and declared fish plugins?"; then
  fish -c '
    if not functions -q fisher
      curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
      fisher install jorgebucaran/fisher
    end
    fisher update
  ' || true
fi

watcher_label="$([ "$OS" = Darwin ] && echo 'launchd agent' || echo 'systemd service')"
if ask "Install dotfiles-watcher $watcher_label (auto-sync to git)?"; then
  if [[ ! -s "$DOTFILES/machine.local" ]]; then
    if [[ "$OS" == "Darwin" ]]; then
      default_name="$(scutil --get ComputerName 2>/dev/null || hostname -s)"
    else
      default_name="$(hostname -s)"
    fi
    read -rp "Machine name (used in commit messages) [${default_name}]: " mname
    mname="${mname:-$default_name}"
    echo "$mname" > "$DOTFILES/machine.local"
  fi
  read -rp "Debounce minutes [3]: " mins
  read -rp "Scheduled ff-pull slot, hours [6]: " phrs
  mins="${mins:-3}"; phrs="${phrs:-6}"
  make -C "$DOTFILES" watcher-install \
    DEBOUNCE_SECS=$((mins * 60)) \
    PULL_INTERVAL_SECS=$((phrs * 3600))
fi

echo "==> Done. 'make help' to see commands."
