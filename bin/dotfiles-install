#!/usr/bin/env bash
set -euo pipefail
DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
OS="$(uname -s)"

ask() {
  local prompt="$1" default="${2:-Y}" reply yn
  if [[ "$default" == "Y" ]]; then yn="Y/n"; else yn="y/N"; fi
  read -rp "$prompt [$yn] " reply
  reply="${reply:-$default}"
  [[ "$reply" =~ ^[Yy]$ ]]
}

pkg_install() {
  local pkg="$1"
  if [[ "$OS" == "Darwin" ]]; then
    brew install "$pkg"
  else
    sudo apt-get install -y "$pkg"
  fi
}

echo "==> Checking dependencies"
for tool in stow git; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    if ask "$tool not found. Install via $([ "$OS" = Darwin ] && echo brew || echo apt-get)?"; then
      pkg_install "$tool"
    else
      echo "  skipped; $tool is required"
    fi
  fi
done
if ! command -v fswatch >/dev/null 2>&1; then
  if [[ "$OS" == "Darwin" ]]; then
    ask "fswatch not found. brew install fswatch?" && brew install fswatch || true
  elif ! command -v inotifywait >/dev/null 2>&1; then
    ask "inotifywait not found. sudo apt-get install inotify-tools?" && \
      sudo apt-get install -y inotify-tools || true
  fi
fi

if [[ ! -f "$DOTFILES/zsh/.zshrc" ]]; then
  if ask "No tracked .zshrc in repo. Seed from live configs in \$HOME?"; then
    "$DOTFILES/bin/dotfiles-seed"
  fi
fi

echo "==> Symlinking packages with stow"
make -C "$DOTFILES" stow

echo "==> Linking user-facing bin tools"
make -C "$DOTFILES" bin-link

if ask "Install TPM and tmux plugins?"; then
  if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  fi
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" || true
fi

if ask "Install fisher and declared fish plugins?"; then
  fish -c '
    if not functions -q fisher
      curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
      fisher install jorgebucaran/fisher
    end
    fisher update
  ' || true
fi

watcher_label="$([ "$OS" = Darwin ] && echo 'launchd agent' || echo 'systemd service')"
if ask "Install dotfiles-watcher $watcher_label (auto-sync to git)?"; then
  if [[ ! -s "$DOTFILES/machine.local" ]]; then
    if [[ "$OS" == "Darwin" ]]; then
      default_name="$(scutil --get ComputerName 2>/dev/null || hostname -s)"
    else
      default_name="$(hostname -s)"
    fi
    read -rp "Machine name (used in commit messages) [${default_name}]: " mname
    mname="${mname:-$default_name}"
    echo "$mname" > "$DOTFILES/machine.local"
  fi
  read -rp "Debounce minutes [3]: " mins
  read -rp "Daily ff-pull interval, hours [24]: " phrs
  mins="${mins:-3}"; phrs="${phrs:-24}"
  make -C "$DOTFILES" watcher-install \
    DEBOUNCE_SECS=$((mins * 60)) \
    PULL_INTERVAL_SECS=$((phrs * 3600))
fi

echo "==> Done. 'make help' to see commands."
