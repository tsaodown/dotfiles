#!/usr/bin/env bash
set -euo pipefail

# Close any inherited FDs above stderr so a parent harness (bats, IDE shells,
# ssh-agent forwarding, …) doesn't keep waiting for them after we exit. Without
# this, the backgrounded fswatch child inherits e.g. bats' control pipes and
# bats hangs at end-of-test until they close.
exec </dev/null
for _fd in $(ls /dev/fd/ 2>/dev/null); do
  case "$_fd" in 0|1|2) continue ;; esac
  [[ "$_fd" =~ ^[0-9]+$ ]] || continue
  eval "exec ${_fd}>&-" 2>/dev/null || true
done
unset _fd

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
DEBOUNCE_SECS="${DEBOUNCE_SECS:-180}"
PULL_INTERVAL_SECS="${PULL_INTERVAL_SECS:-21600}"   # scheduled ff-pull slot duration; aligned to local midnight (default 6h → 0/6/12/18 local)
WAKE_GAP_SECS="${WAKE_GAP_SECS:-90}"                # tick gap above this = probable wake-from-sleep
TICK_INTERVAL_SECS="${TICK_INTERVAL_SECS:-30}"      # tick loop sleep; tests shrink this
DRAIN_SECS="${DRAIN_SECS:-2}"                       # grace window after pull/commit to let in-flight fswatch events arrive before clearing the suppression sentinel; tests shrink this
LOG_MAX_SIZE_BYTES="${LOG_MAX_SIZE_BYTES:-5242880}" # rotate log at startup if larger (5 MB)
NETWORK_PROBE_HOST="${NETWORK_PROBE_HOST:-github.com}"
NETWORK_PROBE_PORT="${NETWORK_PROBE_PORT:-22}"
NETWORK_PROBE_TIMEOUT="${NETWORK_PROBE_TIMEOUT:-3}"
# Offline-deferral retry backoff (seconds). Tests shrink these to 1s.
PENDING_BACKOFF_1="${PENDING_BACKOFF_1:-30}"
PENDING_BACKOFF_2="${PENDING_BACKOFF_2:-60}"
PENDING_BACKOFF_3="${PENDING_BACKOFF_3:-120}"
PENDING_BACKOFF_MAX="${PENDING_BACKOFF_MAX:-300}"

# Recheck backoff (seconds) for a gitlink held back pending its submodule push.
# Hours, not minutes — see gitlink_backoff_secs. Tests shrink these.
HELD_GITLINK_BACKOFF_1="${HELD_GITLINK_BACKOFF_1:-60}"
HELD_GITLINK_BACKOFF_2="${HELD_GITLINK_BACKOFF_2:-300}"
HELD_GITLINK_BACKOFF_3="${HELD_GITLINK_BACKOFF_3:-900}"
HELD_GITLINK_BACKOFF_MAX="${HELD_GITLINK_BACKOFF_MAX:-3600}"

# Wall-clock backstop for git network ops (fetch/pull/push). The SSH keepalives
# below catch a *stalled* connection precisely; this is the coarse backstop for
# any other no-progress hang they can't see (wedged DNS, a stuck credential
# helper). Generous by default so a legitimately slow-but-progressing transfer
# isn't killed. A timed-out op exits non-zero and is handled as a transient
# failure (defer + retry), same as any other network error.
NETWORK_OP_TIMEOUT="${NETWORK_OP_TIMEOUT:-120}"

# SSH keepalive + connect timeout for git's SSH transport. Without these, a
# network drop mid-transfer leaves SSH blocked on a dead socket until the OS TCP
# retransmission timeout (~15 min on macOS) — long enough to look like a hang.
# Keepalives tear a silent connection down in ~interval*count seconds. Scoped to
# git's own SSH calls via GIT_SSH_COMMAND, so interactive/long-lived SSH
# sessions are untouched. A pre-set GIT_SSH_COMMAND wins (operator/test override;
# the bats fixture uses a filesystem remote and never invokes ssh).
SSH_KEEPALIVE_INTERVAL="${SSH_KEEPALIVE_INTERVAL:-10}"
SSH_KEEPALIVE_COUNT="${SSH_KEEPALIVE_COUNT:-3}"
SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ServerAliveInterval=${SSH_KEEPALIVE_INTERVAL} -o ServerAliveCountMax=${SSH_KEEPALIVE_COUNT} -o ConnectTimeout=${SSH_CONNECT_TIMEOUT}}"

# Resolve a timeout(1) implementation for NETWORK_OP_TIMEOUT enforcement. Stock
# macOS ships none; coreutils provides `gtimeout` (and `timeout` if installed
# under its default name). Empty → run network ops unwrapped (graceful degrade,
# behavior is no worse than before; the SSH keepalives still apply).
TIMEOUT_BIN=""
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT_BIN="$(command -v timeout)"
elif command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="$(command -v gtimeout)"
fi

OS="$(uname -s)"

# Source the path resolver — sourcing avoids depending on the helper's +x
# bit on disk (a missing exec bit would otherwise fail before any logging).
# shellcheck source=bin/dotfiles-watcher-paths
. "$DOTFILES/bin/dotfiles-watcher-paths"

# Pure, unit-testable helpers (conflict detection, drain classification). Same
# sourcing rationale as above — sourced, not exec'd, so a missing +x bit can't
# break startup.
# shellcheck source=bin/dotfiles-watcher-lib
. "$DOTFILES/bin/dotfiles-watcher-lib"

# State files. Grouped by lifetime so the startup-cleanup block below is
# self-documenting (it wipes exactly the "transient" group).

# Persistent — survives restarts; updated only by ops that complete:
LAST_CHANGE="$STATE_DIR/last-change"     # debounce timer trigger
LAST_PULL="$STATE_DIR/last-pull"         # gates the slot-aligned scheduled-pull
LAST_HALT_LOG="$STATE_DIR/last-halt-log" # throttle for "watcher halted" log lines
HALT_FILE="$STATE_DIR/halt"              # manual pause; cleared by `make watcher-resume`

# Transient operation sentinels — wiped on watcher startup. Stale values from
# a crashed run would otherwise gate-out new work or trigger spurious resyncs:
SYNCING_FILE="$STATE_DIR/syncing"            # commit_and_push in progress
PULLING_FILE="$STATE_DIR/pulling"            # pull_ff merge in progress
DROPPED_FILE="$STATE_DIR/dropped"            # count of fswatch events dropped during sync
RESYNC_COUNT_FILE="$STATE_DIR/consecutive-resyncs"  # rolling-sync halt counter
PENDING_FILE="$STATE_DIR/pending"            # offline-deferred op (see set_pending)

# Gitlinks held back pending their submodule push (see hold_unresolvable_gitlinks).
# Deliberately NOT cleared on startup, unlike the sentinels above: the daemon
# respawns on every ff-pull that advances HEAD, and resetting the record there
# would restart the backoff and mean the escalation notification never fires.
HELD_GITLINK_FILE="$STATE_DIR/held-gitlinks"
# Respawn-only sentinel — written by pull_ff before exit-on-HEAD-advance,
# consumed and removed once on the next startup to skip the redundant pull:
RESTART_FROM_PULL_FILE="$STATE_DIR/restart-from-pull"

# Test fixture override — only present when an operator/test wants offline mode:
FORCE_OFFLINE_FILE="$STATE_DIR/force-offline"

mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

# Rotate log on startup if it exceeds the size cap. Keeps one backup (.1).
# `stat -f %z` is BSD/macOS file size; `stat -c %s` is GNU/Linux. Branching on
# OS rather than chaining `||` because GNU `stat -f` doesn't fail on bad input
# — it prints filesystem info, which then breaks the arithmetic compare.
if [[ -f "$LOG" ]]; then
  if [[ "$OS" == "Darwin" ]]; then
    log_size=$(stat -f %z "$LOG" 2>/dev/null || echo 0)
  else
    log_size=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
  fi
  if (( log_size > LOG_MAX_SIZE_BYTES )); then
    mv -f "$LOG" "$LOG.1" 2>/dev/null || true
  fi
fi

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $(log_format "$@")" >>"$LOG"; }

# SIGUSR1 → request an immediate wake-pull on the next tick. Useful both for
# operators (`kill -USR1 $(pgrep -f dotfiles-watcher)` to kick a pull) and for
# tests, where it gives a deterministic single-trigger path that doesn't race
# with the SIGSTOP-bracketed `sleep` measurement used by wake-gap detection.
_WAKE_REQUEST=0
trap '_WAKE_REQUEST=1' SIGUSR1

# SIGUSR2 → request an immediate sync on the next tick. Sent by `make
# watcher-sync`, which signals the running daemon rather than backdating the
# debounce trigger — so the commit happens now, not on the next 30s tick. The
# interruptible tick sleep (below) breaks out the instant this fires.
_SYNC_REQUEST=0
trap '_SYNC_REQUEST=1' SIGUSR2

# Format a number of seconds as a human-readable duration up to weeks.
# Examples: 30 → "30s", 90 → "1m 30s", 90061 → "1d 1h 1m 1s".
human_duration() {
  local s=$1 w d h m
  w=$((s / 604800)); s=$((s % 604800))
  d=$((s / 86400));  s=$((s % 86400))
  h=$((s / 3600));   s=$((s % 3600))
  m=$((s / 60));     s=$((s % 60))
  if   (( w > 0 )); then printf '%dw %dd %dh %dm %ds' "$w" "$d" "$h" "$m" "$s"
  elif (( d > 0 )); then printf '%dd %dh %dm %ds' "$d" "$h" "$m" "$s"
  elif (( h > 0 )); then printf '%dh %dm %ds' "$h" "$m" "$s"
  elif (( m > 0 )); then printf '%dm %ds' "$m" "$s"
  else                   printf '%ds' "$s"
  fi
}

notify() {
  # The suite drives halts and held-gitlink escalations on purpose; without this
  # a test run posts real desktop notifications.
  [[ -n "${WATCHER_NO_NOTIFY:-}" ]] && return 0
  if [[ "$OS" == "Darwin" ]]; then
    osascript -e "display notification \"$2\" with title \"$1\"" 2>/dev/null || true
  else
    command -v notify-send >/dev/null 2>&1 && \
      notify-send "$1" "$2" 2>/dev/null || true
  fi
}

# Local-timezone offset in seconds (local minus UTC). `date +%z` is portable
# across BSD/macOS and GNU coreutils. Used to align scheduled-pull slots to
# local midnight rather than UTC midnight: shifting epoch by this offset before
# integer-dividing by the slot size gives slot boundaries at local 0/6/12/18.
tz_offset_secs() {
  local z hh mm off
  z="$(date +%z)"
  # 10# forces base-10 so leading zeros aren't parsed as octal (08, 09 → error).
  hh=$(( 10#${z:1:2} ))
  mm=$(( 10#${z:3:2} ))
  off=$(( hh * 3600 + mm * 60 ))
  [[ "${z:0:1}" == "-" ]] && off=$(( -off ))
  printf '%s\n' "$off"
}

# Returns 0 if `now` and the timestamp in $LAST_PULL fall in different
# PULL_INTERVAL_SECS slots (slots aligned to local midnight via tz_offset).
# A missing/zero LAST_PULL is treated as "in the current slot" so a fetch
# that failed at startup doesn't immediately re-fire — pending-op retries
# handle that case.
slot_crossed_since_last_pull() {
  local now="$1" last_pull tz_off
  last_pull=$(cat "$LAST_PULL" 2>/dev/null || echo 0)
  (( last_pull == 0 )) && return 1
  tz_off=$(tz_offset_secs)
  (( (now + tz_off) / PULL_INTERVAL_SECS > (last_pull + tz_off) / PULL_INTERVAL_SECS ))
}

# Probe whether we can reach the git remote, used to defer pulls/syncs when
# the machine is offline (e.g., wake from sleep without network) instead of
# halting or silently failing. `nc -z -w` is portable: BSD nc (macOS default)
# and GNU nc both accept `-w` as the connect timeout. If nc is missing, we
# degrade to "always online" so behavior is no worse than before.
# Test overrides (offline takes priority over online when both are set):
#   - WATCHER_FORCE_OFFLINE=1 (env)            → always offline
#   - $FORCE_OFFLINE_FILE present              → always offline (togglable mid-test)
#   - WATCHER_FORCE_ONLINE=1 (env)             → bypass nc probe, always online;
#                                                  used by the bats fixture so tests
#                                                  don't depend on real network
is_online() {
  if [[ -n "${WATCHER_FORCE_OFFLINE:-}" ]] || [[ -f "$FORCE_OFFLINE_FILE" ]]; then
    return 1
  fi
  if [[ -n "${WATCHER_FORCE_ONLINE:-}" ]]; then
    return 0
  fi
  if ! command -v nc >/dev/null 2>&1; then
    return 0
  fi
  nc -z -w "$NETWORK_PROBE_TIMEOUT" "$NETWORK_PROBE_HOST" "$NETWORK_PROBE_PORT" 2>/dev/null
}

# Resolve the machine name used in commit messages.
# Priority: $MACHINE_NAME env var → $DOTFILES/machine.local → scutil → hostname.
get_machine_name() {
  if [[ -n "${MACHINE_NAME:-}" ]]; then
    printf '%s' "$MACHINE_NAME"
    return
  fi
  if [[ -s "$DOTFILES/machine.local" ]]; then
    head -1 "$DOTFILES/machine.local" | tr -d '\r\n'
    return
  fi
  if [[ "$OS" == "Darwin" ]]; then
    scutil --get ComputerName 2>/dev/null || hostname -s
  else
    hostname -s
  fi
}

is_halted() { [[ -f "$HALT_FILE" ]]; }

halt() {
  local reason="$1"
  {
    date '+%Y-%m-%d %H:%M:%S'
    echo "$reason"
  } >"$HALT_FILE"
  log error "HALT: $reason"
  notify "dotfiles sync paused" "$reason. Run: make watcher-resume"
}

# Backoff schedule for offline-deferred-op retries. Capped at 5 min so we
# don't spam network probes on long outages but we recover quickly on short ones.
backoff_secs() {
  case "$1" in
    1) echo "$PENDING_BACKOFF_1" ;;
    2) echo "$PENDING_BACKOFF_2" ;;
    3) echo "$PENDING_BACKOFF_3" ;;
    *) echo "$PENDING_BACKOFF_MAX" ;;
  esac
}

# Pending-op state machine. At most ONE op is pending at a time. State lives
# in a single file with three space-separated fields:
#
#   <op>  <next-retry-epoch>  <attempts>
#
# States:
#   NONE             — file absent (default)
#   PENDING-PULL     — op ∈ {wake-pull, scheduled-pull, startup-pull}
#   PENDING-COMMIT   — op = commit-rebase
#
# Transitions:
#   set_pending <op>:
#     PENDING-COMMIT + new pull op → no-op (commit has higher priority)
#     otherwise                    → write op + initial backoff
#   bump_pending (retry tick fired while still offline):
#     advance attempts; recompute next-retry per backoff schedule
#   clear_pending <scope>:
#     scope=all       → wipe regardless of current op
#     scope=pull-only → wipe only if current op is a pull op
#
# Priority rationale: a deferred commit-rebase carries unsynced user edits.
# A pull op cannot displace it — pull ops are purely recoverable (wake-tick
# or next slot will retrigger them); a lost commit-rebase, by contrast,
# leaves edits sitting in the working tree indefinitely (LAST_CHANGE was
# already cleared when the original debounce expired). pull_ff therefore
# uses clear_pending pull-only on success.

# Read PENDING_FILE into the variables PENDING_OP / PENDING_NEXT_RETRY /
# PENDING_ATTEMPTS. Returns 1 if no pending state exists.
read_pending() {
  [[ -f "$PENDING_FILE" ]] || return 1
  read -r PENDING_OP PENDING_NEXT_RETRY PENDING_ATTEMPTS < "$PENDING_FILE"
}

# write_pending <op> <next-retry-epoch> <attempts>
write_pending() {
  printf '%s %s %s\n' "$1" "$2" "$3" > "$PENDING_FILE"
}

set_pending() {
  local op="$1" reason="${2:-offline}" now had_pending=0
  now=$(date +%s)
  if read_pending; then
    had_pending=1
    if [[ "$PENDING_OP" == "commit-rebase" && "$op" != "commit-rebase" ]]; then
      return
    fi
  fi
  write_pending "$op" "$((now + PENDING_BACKOFF_1))" 1
  if (( had_pending == 0 )); then
    log "$op deferred ($reason) — retry in ${PENDING_BACKOFF_1}s"
  fi
}

# Logs every retry so ongoing outages are visible. Backoff caps at
# PENDING_BACKOFF_MAX (default 5min) → ~12 log lines/hr during long outages,
# not per-tick spam. Inspect $PENDING_FILE for live state between log lines.
bump_pending() {
  read_pending || return
  local attempts=$((PENDING_ATTEMPTS + 1))
  local next_secs=$(backoff_secs "$attempts")
  local next=$(( $(date +%s) + next_secs ))
  write_pending "$PENDING_OP" "$next" "$attempts"
  log "$PENDING_OP still offline (attempt $attempts) — retry in ${next_secs}s"
}

clear_pending() {
  local scope="${1:-all}"
  if read_pending; then
    if [[ "$scope" == "pull-only" && "$PENDING_OP" == "commit-rebase" ]]; then
      return
    fi
    log "back online — $PENDING_OP completed"
  fi
  rm -f "$PENDING_FILE"
}

# After a successful ff-pull that advanced HEAD, the running watcher process
# is stale (its own code may have changed). Drop a sentinel so the respawned
# process skips its startup-pull, then exit cleanly so the supervisor (launchd
# KeepAlive / systemd Restart=always) brings us back on the new code. The
# EXIT trap kills the fswatch child; PULLING_FILE is cleaned by the respawn.
respawn_after_head_advance() {
  local before="$1" after="$2"
  log ok "ff-pull advanced HEAD ${before:0:7} → ${after:0:7}; restarting to pick up changes"
  touch "$RESTART_FROM_PULL_FILE"
  exit 0
}

# Run a git network op (fetch/pull/push) under the wall-clock backstop. `-k 10`
# follows the SIGTERM with a SIGKILL 10s later in case git is wedged in a
# syscall and ignores the term. Degrades to running the command directly when
# no timeout(1) is available. Exit codes when the backstop fires: 124 (timeout
# sent SIGTERM) or 137 (128+9, the -k SIGKILL fired) — callers that care
# special-case those as "stalled, retry" rather than a real git error.
run_net() {
  if [[ -n "$TIMEOUT_BIN" ]]; then
    "$TIMEOUT_BIN" -k 10 "$NETWORK_OP_TIMEOUT" "$@"
  else
    "$@"
  fi
}

pull_ff() {
  # Context label ("wake", "scheduled", "startup") — used as the deferred-op
  # label when offline and to label the "no changes to pull" log on success.
  local context="${1:-scheduled}"
  cd "$DOTFILES" || return
  if ! is_online; then
    set_pending "${context}-pull"
    return
  fi
  if ! run_net git fetch --quiet origin >>"$LOG" 2>&1; then
    log error "fetch failed despite online probe — deferring"
    set_pending "${context}-pull"
    return
  fi
  local before after merged=1
  before=$(git rev-parse HEAD 2>/dev/null || echo "")

  # `git merge --ff-only` rewrites working-tree files on advance; without
  # suppression fswatch sees those writes as user edits and starts a debounce.
  # PULLING_FILE is separate from SYNCING_FILE so a concurrent commit-flow
  # commit_drain_sentinel cannot clear our suppression mid-merge.
  touch "$PULLING_FILE"

  if ! git merge --ff-only --quiet origin/main >>"$LOG" 2>&1; then
    log warn "ff-pull skipped (local has unpushed commits or diverges)"
    merged=0
  fi
  after=$(git rev-parse HEAD 2>/dev/null || echo "")
  # LAST_PULL is updated even when merged=0 (diverge case). The slot gate is
  # "have we contacted the remote in this slot?" — a successful fetch that
  # found we'd diverge still answers "yes, no point fetching again."
  date +%s >"$LAST_PULL"
  # pull-only scope: don't wipe a pending commit-rebase here — pull_ff is
  # fast-forward only and never commits, so it can't substitute for a deferred
  # sync of user edits.
  clear_pending pull-only

  if [[ -n "$before" && "$before" != "$after" ]]; then
    respawn_after_head_advance "$before" "$after"
  fi

  # Confirming log only on the clean-no-op path: the diverge case already
  # logged "ff-pull skipped" above, and a fetch failure returned early.
  if (( merged == 1 )) && [[ -n "$context" ]]; then
    log "${context}-pull: no changes to pull"
  fi

  # Drain queued FSEvents before clearing the sentinel. Synchronous (vs the
  # commit-flow drain which is backgrounded) — that drain does commit-specific
  # post-checks (resync counter, dirty-tree halt) that don't apply to a clean
  # ff-pull, so we don't reuse it.
  #
  # Startup pull_ff runs before fswatch is spawned (see end-of-script), so there
  # is no event stream to drain and nothing reads PULLING_FILE. Skipping the
  # sleep here cuts cold-start latency by DRAIN_SECS and — critically — closes
  # the SIGTERM window in which a supervisor's bounded-wait teardown could
  # SIGKILL bash mid-drain and orphan a not-yet-spawned fswatch on respawn.
  if [[ "$context" != "startup" ]]; then
    sleep "$DRAIN_SECS"
  fi
  rm -f "$PULLING_FILE"
}

# ---------- held gitlinks ----------
#
# A gitlink only means anything to anyone else once the commit it names exists
# on the submodule's own remote. The parent syncs on this daemon's cadence, the
# submodule on a human's, so the parent readily publishes a pointer no fresh
# `clone --recursive` or CI checkout can resolve ("upload-pack: not our ref").
#
# The daemon does not push the submodule to fix that — a submodule is a separate
# repo with its own release cadence, and pushing it is the user's call. Instead
# the offending path is held out of the sync while everything else goes through,
# and rechecked on a backoff until the commit lands.
#
# One tab-separated record per held path:
#   <path>  <sha>  <held-since-epoch>  <next-recheck-epoch>  <attempts>

held_gitlink_paths() {
  [[ -f "$HELD_GITLINK_FILE" ]] || return 0
  cut -f1 "$HELD_GITLINK_FILE" 2>/dev/null || true
}

# Sets HELD_* for <path>; returns 1 when that path isn't held.
read_held_gitlink() {
  local line
  [[ -f "$HELD_GITLINK_FILE" ]] || return 1
  line=$(awk -F'\t' -v p="$1" '$1 == p' "$HELD_GITLINK_FILE" 2>/dev/null | head -1)
  [[ -n "$line" ]] || return 1
  IFS=$'\t' read -r HELD_PATH HELD_SHA HELD_SINCE HELD_NEXT HELD_ATTEMPTS <<<"$line"
}

write_held_gitlink() {
  local path="$1" tmp="$HELD_GITLINK_FILE.tmp"
  { [[ -f "$HELD_GITLINK_FILE" ]] && awk -F'\t' -v p="$path" '$1 != p' "$HELD_GITLINK_FILE"; true; } >"$tmp"
  printf '%s\t%s\t%s\t%s\t%s\n' "$path" "$2" "$3" "$4" "$5" >>"$tmp"
  mv "$tmp" "$HELD_GITLINK_FILE"
}

release_held_gitlink() {
  local path="$1" tmp="$HELD_GITLINK_FILE.tmp"
  [[ -f "$HELD_GITLINK_FILE" ]] || return 0
  awk -F'\t' -v p="$path" '$1 != p' "$HELD_GITLINK_FILE" >"$tmp" 2>/dev/null || true
  if [[ -s "$tmp" ]]; then mv "$tmp" "$HELD_GITLINK_FILE"; else rm -f "$tmp" "$HELD_GITLINK_FILE"; fi
}

# Working-tree status with held gitlinks filtered out. Every dirty-tree probe
# goes through this: a deliberately deferred bump must not read as dirt, or the
# tree never settles and drain_decision escalates RETRY → RETRY → ROLLING_HALT,
# stopping all syncing over a pointer we are intentionally sitting on.
working_tree_porcelain() {
  local held line path
  held=$(held_gitlink_paths)
  if [[ -z "$held" ]]; then
    ( cd "$DOTFILES" && git status --porcelain --ignore-submodules=dirty 2>/dev/null )
    return
  fi
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    path=${line:3}   # porcelain v1: two status chars, a space, then the path
    if grep -qxF "$path" <<<"$held"; then continue; fi
    printf '%s\n' "$line"
  done < <( cd "$DOTFILES" && git status --porcelain --ignore-submodules=dirty 2>/dev/null )
}

# True when the submodule's current HEAD exists on its own remote. The fetch is
# what makes that authoritative — remote-tracking refs go stale, and a stale
# "yes" publishes exactly the unresolvable pointer we're guarding against. A
# failed fetch (offline) is "not confirmed", so we hold rather than guess.
submodule_head_on_remote() {
  run_net git -C "$1" fetch --quiet origin >>"$LOG" 2>&1 || return 1
  [[ -n "$(git -C "$1" branch -r --contains "$2" 2>/dev/null)" ]]
}

# Unstage any gitlink whose submodule commit hasn't reached the submodule's
# remote. Runs with the index already populated by `git add -A`, so the rest of
# the sync proceeds untouched and only the bump waits.
hold_unresolvable_gitlinks() {
  local sub path sha now
  # Offline we can't confirm anything, and the sync below defers wholesale
  # anyway. Holding on a guess would log a spurious warn every offline cycle.
  is_online || return 0
  now=$(date +%s)
  for sub in ${SUBMODULE_PATHS[@]+"${SUBMODULE_PATHS[@]}"}; do
    path=${sub#"$DOTFILES/"}
    # An unchanged gitlink is already published; only a staged bump is at risk.
    if git -C "$DOTFILES" diff --cached --quiet -- "$path" 2>/dev/null; then
      release_held_gitlink "$path"
      continue
    fi
    sha=$(git -C "$sub" rev-parse HEAD 2>/dev/null) || continue
    if submodule_head_on_remote "$sub" "$sha"; then
      release_held_gitlink "$path"
      continue
    fi
    git -C "$DOTFILES" reset -q HEAD -- "$path" 2>/dev/null || true
    # Re-holding the same sha keeps the existing schedule — the tick-loop
    # recheck owns the backoff, and resetting it here on every unrelated sync
    # would stall the escalation indefinitely.
    if ! read_held_gitlink "$path" || [[ "$HELD_SHA" != "$sha" ]]; then
      write_held_gitlink "$path" "$sha" "$now" "$((now + HELD_GITLINK_BACKOFF_1))" 1
      log warn "holding $path gitlink — ${sha:0:7} is not on its remote; syncing everything else"
    fi
  done
}

# Recheck held gitlinks on their own backoff. A landed commit restarts the
# debounce so the normal sync path publishes the bump; a still-unpushed one
# escalates the interval and, at the ceiling, notifies.
recheck_held_gitlinks() {
  [[ -f "$HELD_GITLINK_FILE" ]] || return 0
  local now sub path sha attempts since next_secs
  now=$(date +%s)
  for sub in ${SUBMODULE_PATHS[@]+"${SUBMODULE_PATHS[@]}"}; do
    path=${sub#"$DOTFILES/"}
    read_held_gitlink "$path" || continue
    (( now >= HELD_NEXT )) || continue
    sha=$(git -C "$sub" rev-parse HEAD 2>/dev/null) || { release_held_gitlink "$path"; continue; }
    if submodule_head_on_remote "$sub" "$sha"; then
      release_held_gitlink "$path"
      log ok "$path gitlink released — ${sha:0:7} reached its remote after $(human_duration $((now - HELD_SINCE)))"
      date +%s >"$LAST_CHANGE"
      continue
    fi
    # A different sha means a fresh commit inside the submodule — a new wait,
    # not a continuation of the old one.
    if [[ "$HELD_SHA" == "$sha" ]]; then
      attempts=$((HELD_ATTEMPTS + 1)); since=$HELD_SINCE
    else
      attempts=1; since=$now
    fi
    next_secs=$(gitlink_backoff_secs "$attempts" \
      "$HELD_GITLINK_BACKOFF_1" "$HELD_GITLINK_BACKOFF_2" \
      "$HELD_GITLINK_BACKOFF_3" "$HELD_GITLINK_BACKOFF_MAX")
    write_held_gitlink "$path" "$sha" "$since" "$((now + next_secs))" "$attempts"
    log warn "$path gitlink still held (attempt $attempts) — recheck in $(human_duration "$next_secs")"
    if gitlink_at_cap "$attempts"; then
      notify "dotfiles: unpushed submodule" \
             "$path is $(human_duration $((now - since))) behind — push ${sha:0:7} so its gitlink can sync."
    fi
  done
}

commit_and_push() {
  cd "$DOTFILES" || return
  git add -A
  hold_unresolvable_gitlinks
  # Nothing left once the held bumps are out — return before the network paths
  # below, so a held gitlink alone never costs a push or a log line per cycle.
  if git diff --cached --quiet; then return; fi

  # Pre-flight network check before touching any sentinel files. An offline
  # path is then a clean early-return with no cleanup. The post-rebase check
  # below catches the race where network drops between probe and pull-rebase.
  if ! is_online; then
    set_pending "commit-rebase"
    return
  fi

  # Suppress fswatch events for the duration of the sync. `pull --rebase` with
  # autostash rewrites every staged file in the working tree (twice — stash &
  # pop), which would otherwise generate hundreds of spurious change events.
  echo 0 > "$DROPPED_FILE"
  touch "$SYNCING_FILE"
  log "sync started — suppressing fswatch events"

  local pull_rc=0
  run_net git -c rebase.autoStash=true pull --rebase --quiet origin main >>"$LOG" 2>&1 || pull_rc=$?
  if (( pull_rc != 0 )); then
    # A backstop timeout kill (124 = SIGTERM, 137 = 128+9 SIGKILL via -k) means
    # the op stalled, not that the history conflicts — even if the kill happened
    # to leave a partial rebase behind. Abort any partial state and defer,
    # regardless of on-disk evidence, so a slow/hung network never halts.
    if (( pull_rc == 124 || pull_rc == 137 )); then
      git rebase --abort 2>/dev/null || true
      # Logged unconditionally (not just via set_pending, which is silent when an
      # op is already pending) so a recurring stall stays visible in the log.
      log warn "pull --rebase timed out (>${NETWORK_OP_TIMEOUT}s) — deferring"
      set_pending "commit-rebase" "pull --rebase timed out (>${NETWORK_OP_TIMEOUT}s)"
      rm -f "$SYNCING_FILE" "$DROPPED_FILE"
      return
    fi
    # Otherwise distinguish a real rebase conflict (halt — needs the user) from a
    # transient failure like a network drop mid-pull (defer + retry). We key off
    # actual conflict *evidence* captured BEFORE `git rebase --abort` wipes it: a
    # genuine rebase or autostash-pop conflict leaves unmerged index entries (or
    # a live rebase state dir), while a fetch-stage failure leaves neither.
    #
    # The old code re-probed is_online here instead. That was racy: `pull
    # --rebase` can hang for minutes while SSH dies, and connectivity is often
    # back by the time the failure returns — so a network drop got misclassified
    # as a conflict and halted the watcher spuriously.
    local conflicted=0
    repo_in_conflict && conflicted=1
    git rebase --abort 2>/dev/null || true
    if (( conflicted )); then
      halt "rebase conflict during sync"
      commit_drain_sentinel
      return
    fi
    # No conflict evidence → transient failure (offline, fetch error, remote
    # unreachable). Defer and retry rather than halt; the pending-op dispatch
    # re-runs commit_and_push once reachable. The reason label keeps the deferral
    # accurate in the log even when the network probe still reports "online".
    set_pending "commit-rebase" "pull --rebase failed, no conflict"
    rm -f "$SYNCING_FILE" "$DROPPED_FILE"
    return
  fi

  local n host msg
  n=$(git diff --cached --name-only | wc -l | tr -d ' ')
  if (( n == 0 )); then
    run_net git push --quiet >>"$LOG" 2>&1 || log error "push failed (nothing local but push errored)"
    clear_pending
    commit_drain_sentinel
    return
  fi
  host=$(get_machine_name)
  msg="$(date '+%Y-%m-%d %H:%M:%S') ${host} - ${n} file(s) changed"

  if git commit -m "$msg" >>"$LOG" 2>&1; then
    log ok "committed: $msg"
    if run_net git push --quiet >>"$LOG" 2>&1; then
      log ok "pushed"
    else
      log error "push failed; will retry next cycle"
    fi
  fi

  clear_pending
  commit_drain_sentinel
}

# Brief grace window lets any queued FSEvents from the rebase drain before we
# start accepting events again. Backgrounded so we don't block the tick loop.
#
# After the grace window, peek at `git status` to distinguish two cases:
#   1. Working tree clean → suppressed events were autostash/rebase noise; nothing to do.
#   2. Working tree dirty → user edited during the sync window OR autostash-pop
#      conflicts. Restart the debounce so the next tick commits the edits, but
#      halt immediately on conflict markers (auto-committing those would push
#      broken files).
#
# Rolling-sync guard: if 3 consecutive sync cycles end with a dirty tree, halt
# instead of restarting the debounce again.
commit_drain_sentinel() {
  (
    sleep "$DRAIN_SECS"
    rm -f "$SYNCING_FILE"
    local dropped
    dropped=$(cat "$DROPPED_FILE" 2>/dev/null || echo 0)
    rm -f "$DROPPED_FILE"

    cd "$DOTFILES" || { log error "drain: cd to $DOTFILES failed"; return; }

    # Gather post-sync state, classify it, then apply. The four-way decision
    # (incl. the rolling-sync 3-strike rule) lives in drain_decision so it's
    # unit-testable without the daemon; this wrapper owns the git reads, the
    # resync counter file, and the side effects for each disposition.
    local conflicted=0 dirty=0 porcelain dirty_n prior
    repo_in_conflict && conflicted=1
    porcelain=$(working_tree_porcelain)
    [[ -n "$porcelain" ]] && dirty=1
    prior=$(cat "$RESYNC_COUNT_FILE" 2>/dev/null || echo 0)

    case "$(drain_decision "$conflicted" "$dirty" "$prior")" in
      CONFLICT)
        halt "post-sync unmerged files; resolve them, then 'make watcher-resume'"
        rm -f "$RESYNC_COUNT_FILE"
        ;;
      CLEAN)
        rm -f "$RESYNC_COUNT_FILE"
        log ok "sync drain complete — suppressed $dropped event(s); working tree clean"
        ;;
      ROLLING_HALT)
        dirty_n=$(printf '%s\n' "$porcelain" | wc -l | tr -d ' ')
        halt "rolling sync: 3 consecutive cycles left files dirty (last drain saw $dirty_n)"
        rm -f "$RESYNC_COUNT_FILE"
        ;;
      RETRY)
        dirty_n=$(printf '%s\n' "$porcelain" | wc -l | tr -d ' ')
        echo "$((prior + 1))" >"$RESYNC_COUNT_FILE"
        log warn "sync drain complete — suppressed $dropped event(s); $dirty_n file(s) still dirty (consecutive #$((prior + 1))) — restarting debounce"
        date +%s >"$LAST_CHANGE"
        ;;
    esac
  ) &
}

LOCK="$STATE_DIR/dotfiles-watcher.lock"
exec 9>"$LOCK"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { log warn "another instance running; exiting"; exit 0; }
fi

# Termination handling. Registered before any subprocess launch so we never have
# a window where fswatch could spawn without cleanup. WATCH_PID is "" until the
# subshell is backgrounded — the cleanup tolerates that and no-ops.
#
# Explicit signal traps `exit` so the EXIT trap fires deterministically on
# common termination signals. Bash without these would still run EXIT on
# SIGTERM *eventually*, but only after any synchronous foreground child (e.g.
# `git fetch` inside startup pull_ff) returns — if the supervisor SIGKILLs
# before that, EXIT never runs and the backgrounded fswatch leaks. The signal
# traps don't close that mid-fetch window either; the test fixture's
# pkill-on-fixture-path is what backstops it.
WATCH_PID=""
_cleanup_watcher() {
  log stopping "watcher stopping"
  if [[ -n "$WATCH_PID" ]]; then
    pkill -P "$WATCH_PID" 2>/dev/null || true
    kill "$WATCH_PID" 2>/dev/null || true
  fi
}
trap _cleanup_watcher EXIT
trap 'exit 143' SIGTERM
trap 'exit 130' SIGINT
trap 'exit 129' SIGHUP

# Wipe the "transient" state group declared at the top of this file. Pending
# state is soft — the startup pull_ff below will re-defer if still offline.
# RESYNC_COUNT_FILE is also soft, so a manual restart unblocks the rolling-
# sync halt without a separate flag.
#
# Migration: also wipe the legacy 3-file pending-* layout from older watcher
# versions so they don't sit forever in the state dir.
rm -f "$SYNCING_FILE" "$PULLING_FILE" "$DROPPED_FILE" "$RESYNC_COUNT_FILE" "$PENDING_FILE" \
      "$STATE_DIR/pending-op" "$STATE_DIR/pending-next-retry" "$STATE_DIR/pending-attempts"

if ! command -v nc >/dev/null 2>&1; then
  log warn "nc not found — offline detection disabled, watcher will behave as before"
fi

# Skip the startup-pull when we're respawning right after a HEAD-advance —
# LAST_PULL was just refreshed by that pull, so re-fetching is wasted work.
# The sentinel is written by pull_ff before its `exit 0` and cleared here.
if [[ -f "$RESTART_FROM_PULL_FILE" ]]; then
  rm -f "$RESTART_FROM_PULL_FILE"
  log "startup-pull skipped: respawned after ff-pull advanced HEAD"
else
  pull_ff startup || true
fi

# Safety net for HEAD-advance restart during an offline-edit window: pull_ff's
# `exit 0` after a HEAD-advance triggers supervisor respawn, and the startup
# cleanup above wipes pending state. If the user had uncommitted edits when
# that happened, LAST_CHANGE was already cleared by the original debounce, so
# nothing would re-fire the sync until the user touches a file again. Kickstart
# a fresh debounce when we detect *modifications to tracked files* — exclude
# pure-untracked (`??`) entries so symlinks/unstaged-from-setup don't trigger
# a spurious debounce on every cold start. working_tree_porcelain drops
# in-submodule working-tree edits (not stageable from the parent) and held
# gitlinks, neither of which a debounce could clear.
if [[ -n "$(working_tree_porcelain | grep -v '^??')" ]]; then
  date +%s >"$LAST_CHANGE"
fi

# Submodule worktree paths to ignore. Submodules are separate repos with their
# own commit cadence; bouncing the parent watcher on every keystroke inside one
# is at best log noise (commit_and_push runs, finds no staged content, returns)
# and at worst silent gitlink churn (any commit inside the submodule advances
# its HEAD, which `git add -A` here stages as a pointer bump bundled into an
# unrelated parent sync). Treat the submodule worktree like a foreign directory.
SUBMODULE_PATHS=()
if [[ -f "$DOTFILES/.gitmodules" ]]; then
  while IFS= read -r _sub_path; do
    [[ -n "$_sub_path" ]] && SUBMODULE_PATHS+=("$DOTFILES/$_sub_path")
  done < <(git -C "$DOTFILES" config -f "$DOTFILES/.gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')
  unset _sub_path
fi

# Held gitlinks deliberately survive a restart so the escalation clock isn't
# reset by the ff-pull respawn. The world may have moved while we were down
# though, so drop records for paths that are no longer submodules and mark the
# survivors due immediately (next-recheck 0) rather than trusting a stale
# deadline.
if [[ -f "$HELD_GITLINK_FILE" ]]; then
  _held_tmp="$HELD_GITLINK_FILE.tmp"
  : >"$_held_tmp"
  while IFS=$'\t' read -r _hp _hsha _hsince _hnext _hattempts; do
    [[ -n "$_hp" ]] || continue
    for _sub in ${SUBMODULE_PATHS[@]+"${SUBMODULE_PATHS[@]}"}; do
      if [[ "${_sub#"$DOTFILES/"}" == "$_hp" ]]; then
        printf '%s\t%s\t%s\t0\t%s\n' "$_hp" "$_hsha" "$_hsince" "$_hattempts" >>"$_held_tmp"
        break
      fi
    done
  done <"$HELD_GITLINK_FILE"
  if [[ -s "$_held_tmp" ]]; then mv "$_held_tmp" "$HELD_GITLINK_FILE"
  else rm -f "$_held_tmp" "$HELD_GITLINK_FILE"; fi
  unset _held_tmp _hp _hsha _hsince _hnext _hattempts _sub
fi

log "watcher started (debounce=${DEBOUNCE_SECS}s, scheduled-pull-slot=${PULL_INTERVAL_SECS}s)"

# Prefer fswatch (works on macOS + Linux). Fall back to inotifywait (Linux, inotify-tools).
# .git/ is excluded structurally; .gitignore filtering is handled per-event inside the loop.
if command -v fswatch >/dev/null 2>&1; then
  watch_cmd() { fswatch -r --exclude '/\.git(/|$)' "$DOTFILES"; }
elif command -v inotifywait >/dev/null 2>&1; then
  watch_cmd() {
    inotifywait -r -m \
      --format '%w%f' \
      --exclude '/\.git/' \
      -e modify,create,delete,move,moved_to,moved_from \
      "$DOTFILES"
  }
else
  log error "neither fswatch nor inotifywait found — install one and restart watcher"
  exit 1
fi

# Background the fswatch reader pipeline. The read loop subshell cd's into
# $DOTFILES once so per-event `git check-ignore` runs without a wrapping
# subshell — saves a fork per event during high churn.
(
  cd "$DOTFILES" || exit 1
  watch_cmd | while read -r path; do
    # Belt-and-suspenders: exclude .git/ internals not caught by the watcher filter
    [[ "$path" == "$DOTFILES/.git"* ]] && continue
    # Skip events anywhere inside a submodule worktree. Changes to .gitmodules
    # itself (add/remove a submodule) still come through — the prefix match is
    # on the submodule path, not the metadata file.
    # The ${SUBMODULE_PATHS[@]+...} expansion form is a bash 3.2 workaround:
    # plain "${arr[@]}" on an empty array trips set -u and kills this subshell.
    in_submodule=0
    for _sub in ${SUBMODULE_PATHS[@]+"${SUBMODULE_PATHS[@]}"}; do
      if [[ "$path" == "$_sub" || "$path" == "$_sub"/* ]]; then
        in_submodule=1
        break
      fi
    done
    (( in_submodule )) && continue
    is_halted && continue
    # Drop events fired during a sync (autostash rewrites the working tree).
    # `read < file` keeps this hot path free of `cat` forks during high churn.
    if [[ -f "$SYNCING_FILE" ]]; then
      current=0
      [[ -f "$DROPPED_FILE" ]] && read -r current < "$DROPPED_FILE"
      echo $((current + 1)) > "$DROPPED_FILE"
      continue
    fi
    # Drop events fired during a pull_ff merge (ff-only rewrites working-tree files).
    [[ -f "$PULLING_FILE" ]] && continue
    git check-ignore -q "$path" 2>/dev/null && continue
    rel="${path#$DOTFILES/}"
    if [[ ! -f "$LAST_CHANGE" ]]; then
      log "change detected: $rel — debounce timer started (${DEBOUNCE_SECS}s)"
    else
      log "change detected: $rel — debounce timer reset"
    fi
    date +%s >"$LAST_CHANGE"
  done
) </dev/null &
WATCH_PID=$!
# Cleanup trap registered at top-of-script (see _cleanup_watcher); pkill -P
# targets WATCH_PID's children so the actual fswatch/inotifywait dies before
# its parent subshell, preventing reparenting to launchd with inherited FDs.

# Tick loop runs in the foreground main shell.
while true; do
  # Measure the actual wall-clock duration of the tick sleep. During system
  # sleep the process is suspended, so a much-longer-than-tick gap is a
  # reliable wake-from-sleep signal. Trigger a fresh pull on detection, or
  # on an explicit SIGUSR1 wake-request.
  before=$(date +%s)
  # Adaptive tick: when a debounce window is closing in less than a full tick,
  # sleep only until it expires so the sync fires at the promised time (the
  # "time to sync: Ns" line / the debounce deadline) instead of slipping to the
  # next fixed tick boundary. Otherwise sleep a full TICK_INTERVAL_SECS.
  tick=$TICK_INTERVAL_SECS
  if [[ -f "$LAST_CHANGE" ]]; then
    last_change=$(cat "$LAST_CHANGE" 2>/dev/null || echo 0)
    remaining=$((DEBOUNCE_SECS - (before - last_change)))
    (( remaining > 0 && remaining < tick )) && tick=$remaining
  fi
  # Interruptible tick: a trapped SIGUSR1 (wake-pull) / SIGUSR2 (manual sync)
  # breaks out of `wait` in milliseconds instead of after the full tick. The
  # interrupted wait returns >128, so `|| true` keeps it from tripping set -e;
  # the kill reaps the still-running sleep child (stderr silenced). An early
  # break keeps now-before small, so wake-gap detection below doesn't misfire.
  sleep "$tick" & _tick_sleep_pid=$!
  wait "$_tick_sleep_pid" 2>/dev/null || true
  kill "$_tick_sleep_pid" 2>/dev/null || true
  now=$(date +%s)
  if (( now - before > WAKE_GAP_SECS )); then
    log "tick gap of $(human_duration $((now - before))) — likely woke from sleep; pulling"
    pull_ff wake
  elif (( _WAKE_REQUEST )); then
    _WAKE_REQUEST=0
    log "wake-pull requested (SIGUSR1) — pulling"
    pull_ff wake
  fi

  # Pending-op dispatch: a prior pull_ff or commit_and_push deferred itself
  # due to offline. When the next-retry timestamp passes, re-probe network
  # and either bump the backoff (still offline) or run the recovery action.
  if read_pending && (( now >= PENDING_NEXT_RETRY )); then
    if ! is_online; then
      bump_pending
    else
      case "$PENDING_OP" in
        wake-pull|scheduled-pull|startup-pull)
          pull_ff "${PENDING_OP%-pull}"
          ;;
        commit-rebase)
          commit_and_push
          ;;
      esac
    fi
  fi

  # Held-gitlink recheck, on its own (much slower) backoff. Gated on the sync
  # sentinels so its fetch can't race an in-flight rebase.
  if [[ ! -f "$SYNCING_FILE" && ! -f "$PULLING_FILE" ]] && is_online; then
    recheck_held_gitlinks
  fi

  if slot_crossed_since_last_pull "$now"; then
    pull_ff scheduled
  fi

  # Manual immediate-sync request (SIGUSR2, via `make watcher-sync`). Runs ahead
  # of the halt gate so an explicit user request overrides a manual pause or a
  # rolling-sync halt — but never commits through real conflict markers, and
  # never overlaps an in-flight sync/pull.
  if (( _SYNC_REQUEST )); then
    _SYNC_REQUEST=0
    if [[ -f "$SYNCING_FILE" || -f "$PULLING_FILE" ]]; then
      log "manual sync requested — a sync/pull is already in progress; ignoring"
    elif ( cd "$DOTFILES" && repo_in_conflict ); then
      log warn "manual sync requested — refused: working tree has conflict markers (resolve, then 'make watcher-resume')"
    else
      log "manual sync requested — syncing now"
      rm -f "$LAST_CHANGE"   # prevent the debounce block below from double-firing
      commit_and_push
    fi
  fi

  if is_halted; then
    # Log every 10 minutes while halted so the state is visible without spamming
    last_halt_log=$(cat "$LAST_HALT_LOG" 2>/dev/null || echo 0)
    if (( now - last_halt_log >= 600 )); then
      log warn "skipping tick — watcher is HALTED (run: make watcher-resume)"
      echo "$now" > "$LAST_HALT_LOG"
    fi
    continue
  fi

  # Kickstart debounce for tracked-file changes fswatch can't surface. The
  # read loop above filters out every event inside a submodule worktree, which
  # is correct for per-keystroke noise but also swallows the one signal that
  # matters: a commit inside the submodule advances the parent's gitlink, a
  # real parent-repo change. Without this poll the dirty gitlink sits until
  # an unrelated parent edit triggers a debounce, or the watcher restarts
  # (the startup kickstart above catches it then). Gated on the sync/pull
  # sentinels so transient dirty state during pull-rebase/ff-merge doesn't
  # trip a false trigger; ?? entries excluded to match the startup logic.
  if [[ ! -f "$LAST_CHANGE" && ! -f "$SYNCING_FILE" && ! -f "$PULLING_FILE" ]]; then
    # working_tree_porcelain drops in-submodule working-tree edits (they show as
    # dirty but `git add -A` can't stage them, so they'd loop forever here) and
    # held gitlinks (deliberately deferred; a debounce can't clear those either).
    if [[ -n "$(working_tree_porcelain | grep -v '^??')" ]]; then
      log "tick-detected dirty tree (likely submodule pointer bump) — debounce timer started (${DEBOUNCE_SECS}s)"
      date +%s >"$LAST_CHANGE"
    fi
  fi

  if [[ -f "$LAST_CHANGE" ]]; then
    last_change=$(cat "$LAST_CHANGE" 2>/dev/null || echo 0)
    remaining=$((DEBOUNCE_SECS - (now - last_change)))
    if (( remaining <= 0 )); then
      rm -f "$LAST_CHANGE"
      log "debounce window expired (${DEBOUNCE_SECS}s quiet) — syncing"
      commit_and_push
    else
      log trace "time to sync: ${remaining}s"
    fi
  fi
done
