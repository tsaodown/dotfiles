#!/usr/bin/env bash
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/dotfiles}"
DEBOUNCE_SECS="${DEBOUNCE_SECS:-180}"
PULL_INTERVAL_SECS="${PULL_INTERVAL_SECS:-86400}"   # 24h daily ff-pull
WAKE_GAP_SECS="${WAKE_GAP_SECS:-90}"                # tick gap above this = probable wake-from-sleep
OS="$(uname -s)"

if [[ "$OS" == "Darwin" ]]; then
  STATE_DIR="$HOME/Library/Application Support/dotfiles-watcher"
  LOG="$HOME/Library/Logs/dotfiles-watcher.log"
else
  STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/watcher"
  LOG="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/watcher.log"
fi
LAST_CHANGE="$STATE_DIR/last-change"
LAST_PULL="$STATE_DIR/last-pull"
HALT_FILE="$STATE_DIR/halt"
SYNCING_FILE="$STATE_DIR/syncing"
PULLING_FILE="$STATE_DIR/pulling"
DROPPED_FILE="$STATE_DIR/dropped"

mkdir -p "$STATE_DIR" "$(dirname "$LOG")"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOG"; }

notify() {
  if [[ "$OS" == "Darwin" ]]; then
    osascript -e "display notification \"$2\" with title \"$1\"" 2>/dev/null || true
  else
    command -v notify-send >/dev/null 2>&1 && \
      notify-send "$1" "$2" 2>/dev/null || true
  fi
}

# Resolve the machine name used in commit messages.
# Priority: $MACHINE_NAME env var → $DOTFILES/machine.local → scutil → hostname.
get_machine_name() {
  if [[ -n "${MACHINE_NAME:-}" ]]; then
    printf '%s' "$MACHINE_NAME"
    return
  fi
  if [[ -s "$DOTFILES/machine.local" ]]; then
    head -1 "$DOTFILES/machine.local" | tr -d '\r\n'
    return
  fi
  if [[ "$OS" == "Darwin" ]]; then
    scutil --get ComputerName 2>/dev/null || hostname -s
  else
    hostname -s
  fi
}

is_halted() { [[ -f "$HALT_FILE" ]]; }

halt() {
  local reason="$1"
  {
    date '+%Y-%m-%d %H:%M:%S'
    echo "$reason"
  } >"$HALT_FILE"
  log "HALT: $reason"
  notify "dotfiles sync paused" "$reason. Run: make watcher-resume"
}

pull_ff() {
  # Optional context label (e.g. "wake") — when set and the merge succeeds with
  # no advance, we emit a confirming "no changes to pull" log so the wake-tick
  # timeline doesn't end mid-sentence in the log.
  local context="${1:-}"
  cd "$DOTFILES" || return
  git fetch --quiet origin >>"$LOG" 2>&1 || { log "fetch failed"; return; }
  local before after merged=1
  before=$(git rev-parse HEAD 2>/dev/null || echo "")

  # `git merge --ff-only` rewrites working-tree files on advance; without
  # suppression fswatch sees those writes as user edits and starts a debounce.
  # PULLING_FILE is separate from SYNCING_FILE so a concurrent commit-flow
  # drain_sentinel cannot clear our suppression mid-merge.
  touch "$PULLING_FILE"

  if ! git merge --ff-only --quiet origin/main >>"$LOG" 2>&1; then
    log "ff-pull skipped (local has unpushed commits or diverges)"
    merged=0
  fi
  after=$(git rev-parse HEAD 2>/dev/null || echo "")
  date +%s >"$LAST_PULL"

  # If HEAD advanced, the watcher itself or its config may have changed on disk
  # but our running process is on the old code. Exit cleanly so launchd
  # (KeepAlive) / systemd (Restart=always) respawns us with the new code.
  # `kill -TERM $$` targets the main shell whether we're called from it or
  # from the backgrounded tick subshell ($$ refers to the parent shell).
  # PULLING_FILE is cleaned by the respawn's startup `rm -f`.
  if [[ -n "$before" && "$before" != "$after" ]]; then
    log "ff-pull advanced HEAD ${before:0:7} → ${after:0:7}; restarting to pick up changes"
    kill -TERM "$$" 2>/dev/null || true
    exit 0
  fi

  # Confirming log only on the clean-no-op path: the diverge case already
  # logged "ff-pull skipped" above, and a fetch failure returned early.
  if (( merged == 1 )) && [[ -n "$context" ]]; then
    log "${context}-pull: no changes to pull"
  fi

  # Drain queued FSEvents before clearing the sentinel. Synchronous (vs
  # commit_and_push's backgrounded drain_sentinel) — drain_sentinel does
  # commit-specific post-checks (resync counter, dirty-tree halt) that don't
  # apply to a clean ff-pull, so we don't reuse it.
  sleep 2
  rm -f "$PULLING_FILE"
}

commit_and_push() {
  cd "$DOTFILES" || return
  git add -A
  if git diff --cached --quiet; then return; fi

  # Suppress fswatch events for the duration of the sync. `pull --rebase` with
  # autostash rewrites every staged file in the working tree (twice — stash &
  # pop), which would otherwise generate hundreds of spurious change events.
  echo 0 > "$DROPPED_FILE"
  touch "$SYNCING_FILE"
  log "sync started — suppressing fswatch events"

  if ! git -c rebase.autoStash=true pull --rebase --quiet origin main >>"$LOG" 2>&1; then
    git rebase --abort 2>/dev/null || true
    halt "rebase conflict during sync"
    drain_sentinel
    return
  fi

  local n host msg
  n=$(git diff --cached --name-only | wc -l | tr -d ' ')
  if (( n == 0 )); then
    git push --quiet >>"$LOG" 2>&1 || log "push failed (nothing local but push errored)"
    drain_sentinel
    return
  fi
  host=$(get_machine_name)
  msg="$(date '+%Y-%m-%d %H:%M:%S') ${host} - ${n} file(s) changed"

  if git commit -m "$msg" >>"$LOG" 2>&1; then
    log "committed: $msg"
    if git push --quiet >>"$LOG" 2>&1; then
      log "pushed"
    else
      log "push failed; will retry next cycle"
    fi
  fi

  drain_sentinel
}

# Brief grace window lets any queued FSEvents from the rebase drain before we
# start accepting events again. Backgrounded so we don't block the tick loop.
#
# After the grace window, peek at `git status` to distinguish two cases:
#   1. Working tree clean → suppressed events were autostash/rebase noise; nothing to do.
#   2. Working tree dirty → user edited during the sync window OR autostash-pop
#      conflicts. Restart the debounce so the next tick commits the edits, but
#      halt immediately on conflict markers (auto-committing those would push
#      broken files).
#
# Rolling-sync guard: if 3 consecutive sync cycles end with a dirty tree, halt
# instead of restarting the debounce again.
RESYNC_COUNT_FILE="$STATE_DIR/consecutive-resyncs"
drain_sentinel() {
  (
    sleep 2
    rm -f "$SYNCING_FILE"
    local dropped
    dropped=$(cat "$DROPPED_FILE" 2>/dev/null || echo 0)
    rm -f "$DROPPED_FILE"

    cd "$DOTFILES" || { log "drain: cd to $DOTFILES failed"; return; }

    # Conflict markers post-sync are non-recoverable by the watcher.
    if [[ -n "$(git ls-files --unmerged 2>/dev/null)" ]]; then
      halt "post-sync unmerged files; resolve them, then 'make watcher-resume'"
      rm -f "$RESYNC_COUNT_FILE"
      return
    fi

    local porcelain
    porcelain=$(git status --porcelain 2>/dev/null)
    if [[ -z "$porcelain" ]]; then
      rm -f "$RESYNC_COUNT_FILE"
      log "sync drain complete — suppressed $dropped event(s); working tree clean"
      return
    fi

    local count dirty_n
    dirty_n=$(printf '%s\n' "$porcelain" | wc -l | tr -d ' ')
    count=$(cat "$RESYNC_COUNT_FILE" 2>/dev/null || echo 0)
    count=$((count + 1))
    if (( count >= 3 )); then
      halt "rolling sync: 3 consecutive cycles left files dirty (last drain saw $dirty_n)"
      rm -f "$RESYNC_COUNT_FILE"
      return
    fi
    echo "$count" >"$RESYNC_COUNT_FILE"
    log "sync drain complete — suppressed $dropped event(s); $dirty_n file(s) still dirty (consecutive #$count) — restarting debounce"
    date +%s >"$LAST_CHANGE"
  ) &
}

LOCK="/tmp/dotfiles-watcher.lock"
exec 9>"$LOCK"
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { log "another instance running; exiting"; exit 0; }
fi

# Clear stale state from a prior crash. RESYNC_COUNT_FILE is a soft-state
# safety counter; resetting it on startup means a manual restart unblocks the
# rolling-sync halt without a separate flag.
rm -f "$SYNCING_FILE" "$PULLING_FILE" "$DROPPED_FILE" "$RESYNC_COUNT_FILE"

pull_ff || true
log "watcher started (debounce=${DEBOUNCE_SECS}s, daily-pull=${PULL_INTERVAL_SECS}s)"

(
  while true; do
    # Measure the actual wall-clock duration of `sleep 30`. During system
    # sleep the process is suspended, so a much-longer-than-30s gap is a
    # reliable wake-from-sleep signal. Trigger a fresh pull on detection.
    before=$(date +%s)
    sleep 30
    now=$(date +%s)
    if (( now - before > WAKE_GAP_SECS )); then
      log "tick gap of $((now - before))s — likely woke from sleep; pulling"
      pull_ff wake
    fi

    last_pull=$(cat "$LAST_PULL" 2>/dev/null || echo 0)
    if (( now - last_pull >= PULL_INTERVAL_SECS )); then
      pull_ff
    fi

    if is_halted; then
      # Log every 10 minutes while halted so the state is visible without spamming
      last_halt_log=$(cat "$STATE_DIR/last-halt-log" 2>/dev/null || echo 0)
      if (( now - last_halt_log >= 600 )); then
        log "skipping tick — watcher is HALTED (run: make watcher-resume)"
        echo "$now" > "$STATE_DIR/last-halt-log"
      fi
      continue
    fi
    if [[ -f "$LAST_CHANGE" ]]; then
      last_change=$(cat "$LAST_CHANGE" 2>/dev/null || echo 0)
      remaining=$((DEBOUNCE_SECS - (now - last_change)))
      if (( remaining <= 0 )); then
        rm -f "$LAST_CHANGE"
        log "debounce window expired (${DEBOUNCE_SECS}s quiet) — syncing"
        commit_and_push
      else
        log "time to sync: ${remaining}s"
      fi
    fi
  done
) &
TICK_PID=$!

# EXIT trap fires regardless of cause — signal, set -e, or normal exit.
# (A separate SIGTERM trap doesn't fire reliably here because `set -euo pipefail`
# can exit the script via the fswatch pipeline failing before the signal trap runs.)
trap 'log "watcher stopping"; kill "${TICK_PID:-}" 2>/dev/null || true' EXIT

# Prefer fswatch (works on macOS + Linux). Fall back to inotifywait (Linux, inotify-tools).
# .git/ is excluded structurally; .gitignore filtering is handled per-event inside the loop.
if command -v fswatch >/dev/null 2>&1; then
  watch_cmd() { fswatch -r --exclude '/\.git(/|$)' "$DOTFILES"; }
elif command -v inotifywait >/dev/null 2>&1; then
  watch_cmd() {
    inotifywait -r -m \
      --format '%w%f' \
      --exclude '/\.git/' \
      -e modify,create,delete,move,moved_to,moved_from \
      "$DOTFILES"
  }
else
  log "ERROR: neither fswatch nor inotifywait found — install one and restart watcher"
  exit 1
fi

watch_cmd |
while read -r path; do
  # Belt-and-suspenders: exclude .git/ internals not caught by the watcher filter
  [[ "$path" == "$DOTFILES/.git"* ]] && continue
  if is_halted; then continue; fi
  # Drop events fired during a sync (autostash rewrites the working tree).
  if [[ -f "$SYNCING_FILE" ]]; then
    echo $(( $(cat "$DROPPED_FILE" 2>/dev/null || echo 0) + 1 )) > "$DROPPED_FILE"
    continue
  fi
  # Drop events fired during a pull_ff merge (ff-only rewrites working-tree files).
  if [[ -f "$PULLING_FILE" ]]; then
    continue
  fi
  if (cd "$DOTFILES" && git check-ignore -q "$path" 2>/dev/null); then
    continue
  fi
  rel="${path#$DOTFILES/}"
  if [[ ! -f "$LAST_CHANGE" ]]; then
    log "change detected: $rel — debounce timer started (${DEBOUNCE_SECS}s)"
  else
    log "change detected: $rel — debounce timer reset"
  fi
  date +%s >"$LAST_CHANGE"
done
