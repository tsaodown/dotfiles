#!/usr/bin/env bash
# Pure, sourceable helpers for dotfiles-watcher. Intentionally free of any
# top-level side effects (no set -e, no I/O, no traps) so both the watcher and
# the bats suite can source it and call these functions in isolation.

# repo_in_conflict — succeeds (0) when the git repo in the current directory
# shows conflict evidence: unmerged index entries, or an in-progress rebase
# (a rebase-merge / rebase-apply state dir). Read-only — it never aborts or
# mutates; callers that need `git rebase --abort` do so explicitly afterward,
# which is why detection must run *before* the abort wipes the evidence.
repo_in_conflict() {
  [[ -n "$(git ls-files --unmerged 2>/dev/null)" ]] \
    || [[ -d "$(git rev-parse --git-path rebase-merge 2>/dev/null)" ]] \
    || [[ -d "$(git rev-parse --git-path rebase-apply 2>/dev/null)" ]]
}

# drain_decision <conflicted> <dirty> <prior_resync_count> — classify the
# outcome of a sync drain. Pure: takes already-gathered state, echoes exactly
# one disposition and touches no files. The caller gathers the inputs (via
# repo_in_conflict + git status + the resync counter) and applies the result:
#
#   CONFLICT      post-sync conflict evidence — halt (non-recoverable)
#   CLEAN         working tree clean — reset the resync counter, done
#   RETRY         dirty, but under the rolling-sync limit — restart debounce,
#                 bump the resync counter to <prior + 1>
#   ROLLING_HALT  this would be the 3rd consecutive dirty drain — halt
drain_decision() {
  local conflicted="$1" dirty="$2" prior="$3"
  if (( conflicted )); then echo CONFLICT; return; fi
  if (( ! dirty )); then echo CLEAN; return; fi
  if (( prior + 1 >= 3 )); then echo ROLLING_HALT; return; fi
  echo RETRY
}
