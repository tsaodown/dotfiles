#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-install}"
DISTRO="${WSL_DISTRO_NAME:-Ubuntu}"
TASK_NAME="${WSL_AUTOSTART_TASK_NAME:-WSL on Startup}"

is_wsl() { grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; }

if ! is_wsl; then
  echo "wsl-autostart: not running under WSL — nothing to do"
  exit 0
fi

userprofile_win="$(cmd.exe /C 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r\n')"
if [[ -z "$userprofile_win" ]]; then
  echo "wsl-autostart: could not resolve %USERPROFILE% via cmd.exe" >&2
  exit 1
fi
userprofile_wsl="$(wslpath "$userprofile_win")"
vbs_path_win="${userprofile_win}\\start-wsl.vbs"
vbs_path_wsl="${userprofile_wsl}/start-wsl.vbs"
ps1_wsl="${userprofile_wsl}/.dotfiles-wsl-autostart.ps1"
ps1_win="${userprofile_win}\\.dotfiles-wsl-autostart.ps1"
status_wsl="${userprofile_wsl}/.dotfiles-wsl-autostart.status"
status_win="${userprofile_win}\\.dotfiles-wsl-autostart.status"

cleanup() { rm -f "$ps1_wsl" "$status_wsl"; }
trap cleanup EXIT

read_status() {
  if [[ -f "$status_wsl" ]]; then cat "$status_wsl"; else echo "MISSING (PowerShell did not write status file)"; fi
}

run_ps1_with_elevation_fallback() {
  local status ps_err
  rm -f "$status_wsl"
  ps_err="$(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1_win" 2>&1 | tr -d '\r' || true)"
  status="$(read_status)"
  if [[ "$status" == OK ]]; then return 0; fi

  if echo "$status$ps_err" | grep -qi 'access is denied'; then
    echo "wsl-autostart: Task Scheduler rejected non-elevated request — UAC prompt incoming..."
    rm -f "$status_wsl"
    powershell.exe -NoProfile -Command "Start-Process powershell.exe -Verb RunAs -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','${ps1_win}') -Wait" 2>&1 | tr -d '\r' || true
    status="$(read_status)"
    if [[ "$status" == OK ]]; then return 0; fi
    echo "wsl-autostart: elevation declined or task operation failed (status: $status)" >&2
    return 1
  fi

  echo "wsl-autostart: PowerShell error (status: $status)" >&2
  [[ -n "$ps_err" ]] && echo "$ps_err" >&2
  return 1
}

case "$ACTION" in
  install)
    if ! grep -Eq '^\s*systemd\s*=\s*true' /etc/wsl.conf 2>/dev/null; then
      echo "wsl-autostart: warning — /etc/wsl.conf missing 'systemd=true'; autostart will fire but services won't stay alive after the launch command exits"
    fi

    cat > "$vbs_path_wsl" <<VBS
CreateObject("WScript.Shell").Run "wsl -d ""${DISTRO}"" -- exit", 0, False
VBS

    cat > "$ps1_wsl" <<PS
\$ErrorActionPreference = 'Stop'
try {
  \$action = New-ScheduledTaskAction -Execute 'wscript.exe' -Argument '"${vbs_path_win}"' -WorkingDirectory '${userprofile_win}'
  \$trigger = New-ScheduledTaskTrigger -AtLogOn
  \$principal = New-ScheduledTaskPrincipal -UserId \$env:USERNAME -LogonType Interactive -RunLevel Limited
  Register-ScheduledTask -TaskName '${TASK_NAME}' -Action \$action -Trigger \$trigger -Principal \$principal -Force | Out-Null
  'OK' | Out-File -FilePath '${status_win}' -Encoding ascii -NoNewline
} catch {
  ('FAIL: ' + \$_.Exception.Message) | Out-File -FilePath '${status_win}' -Encoding ascii -NoNewline
  exit 1
}
PS

    run_ps1_with_elevation_fallback
    echo "wsl-autostart: installed task='${TASK_NAME}' vbs='${vbs_path_win}'"
    ;;

  uninstall)
    cat > "$ps1_wsl" <<PS
\$ErrorActionPreference = 'Stop'
try {
  if (Get-ScheduledTask -TaskName '${TASK_NAME}' -ErrorAction SilentlyContinue) {
    Unregister-ScheduledTask -TaskName '${TASK_NAME}' -Confirm:\$false
  }
  'OK' | Out-File -FilePath '${status_win}' -Encoding ascii -NoNewline
} catch {
  ('FAIL: ' + \$_.Exception.Message) | Out-File -FilePath '${status_win}' -Encoding ascii -NoNewline
  exit 1
}
PS

    run_ps1_with_elevation_fallback
    rm -f "$vbs_path_wsl"
    echo "wsl-autostart: removed task='${TASK_NAME}' and ${vbs_path_win}"
    ;;

  *)
    echo "usage: $(basename "$0") {install|uninstall}" >&2
    exit 2
    ;;
esac
