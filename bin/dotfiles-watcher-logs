#!/usr/bin/env bash
# Colorized `tail -F` for the dotfiles-watcher log.
# Pass through unchanged when stdout isn't a tty or NO_COLOR is set, so the
# on-disk log stays plain text and grep-friendly.
set -euo pipefail

# shellcheck source=bin/dotfiles-watcher-paths
. "$(dirname "${BASH_SOURCE[0]}")/dotfiles-watcher-paths"

if [[ ! -t 1 ]] || [[ -n "${NO_COLOR:-}" ]]; then
  exec tail -F "$LOG"
fi

exec tail -F "$LOG" | awk -f "$(dirname "${BASH_SOURCE[0]}")/dotfiles-watcher-logs.awk"
