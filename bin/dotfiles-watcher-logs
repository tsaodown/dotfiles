#!/usr/bin/env bash
# Colorized `tail -F` for the dotfiles-watcher log.
# Pass through unchanged when stdout isn't a tty or NO_COLOR is set, so the
# on-disk log stays plain text and grep-friendly.
set -euo pipefail

# shellcheck source=bin/dotfiles-watcher-paths
. "$(dirname "${BASH_SOURCE[0]}")/dotfiles-watcher-paths"

if [[ ! -t 1 ]] || [[ -n "${NO_COLOR:-}" ]]; then
  exec tail -F "$LOG"
fi

exec tail -F "$LOG" | awk '
  BEGIN {
    DIM = "\033[2m"; RST = "\033[0m";
    RED = "\033[31m"; GRN = "\033[32m"; YEL = "\033[33m";
    CYN = "\033[36m"; MAG = "\033[35m"; GRY = "\033[90m";
    # Severity tag → color. The watcher emits an explicit "[level]" tag per line
    # (see log_format in dotfiles-watcher-lib), so coloring is a lookup on that
    # field — no grep-matching the message prose, and no ordering hacks.
    color["error"]    = RED;
    color["warn"]     = YEL;
    color["ok"]       = GRN;
    color["info"]     = CYN;
    color["trace"]    = GRY;
    color["stopping"] = MAG;
  }
  {
    if (match($0, /^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} /)) {
      ts = substr($0, 1, 19);
      body = substr($0, 20);   # leading space + "[level] message"
      c = "";
      if (match(body, /^ \[(error|warn|ok|info|trace|stopping)\] /)) {
        lvl = body; sub(/^ \[/, "", lvl); sub(/\].*/, "", lvl);
        c = color[lvl];
      }
      if (c == "") {
        printf "%s%s%s%s\n", DIM, ts, RST, body;
      } else {
        printf "%s%s%s%s%s%s\n", DIM, ts, RST, c, body, RST;
      }
    } else {
      # Lines without our timestamp prefix (e.g. raw git stderr appended via
      # `>>"$LOG" 2>&1`) — dim them so structured lines stand out.
      printf "%s%s%s\n", DIM, $0, RST;
    }
    fflush();
  }
'
