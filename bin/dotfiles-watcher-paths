#!/usr/bin/env bash
# Single source of truth for the dotfiles-watcher's state and log paths.
# Sourceable (sets STATE_DIR and LOG vars) AND executable (prints a path).
#
#   . dotfiles-watcher-paths             # sourced — works without +x
#   dotfiles-watcher-paths {state-dir|log}  # executed — needs +x

OS="$(uname -s)"
if [[ "$OS" == "Darwin" ]]; then
  STATE_DIR="$HOME/Library/Application Support/dotfiles-watcher"
  LOG="$HOME/Library/Logs/dotfiles-watcher.log"
else
  STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/watcher"
  LOG="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/watcher.log"
fi

# When sourced, ${BASH_SOURCE[0]} differs from $0; return so we don't run the
# CLI block. set -e is deliberately deferred to after this guard so sourcing
# doesn't change the caller's option state.
if [[ "${BASH_SOURCE[0]:-}" != "${0:-}" ]]; then
  return 0
fi

set -euo pipefail
case "${1:-}" in
  state-dir) printf '%s\n' "$STATE_DIR" ;;
  log)       printf '%s\n' "$LOG" ;;
  *) echo "usage: $(basename "$0") {state-dir|log}" >&2; exit 2 ;;
esac
